# Required: Azure DevOps organization name (e.g. "myorg" from dev.azure.com/myorg)
AZURE_DEVOPS_ORG=myorg

# Required when AUTHENTICATION=envvar: Personal Access Token
ADO_MCP_AUTH_TOKEN=your-pat-here

# Optional: override the default auth type (request | envvar | pat | azcli | interactive)
AUTHENTICATION=envvar

# Optional: host port mapping (container always listens on 3000)
PORT=3000

# Optional: custom base URL for on-premises TFS/Azure DevOps Server
# AZURE_DEVOPS_URL=https://tfs.contoso.com/tfs/DefaultCollection

# Optional: set to any non-empty value to disable SSL certificate verification (self-signed certs)
# INSECURE=true

# Optional: Azure tenant ID — for interactive/azcli auth on multi-tenant environments
# TENANT=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: override Azure DevOps REST API version (default: 7.2-preview.1)
# API_VERSION=7.1

# Optional: space-separated list of domains to enable (default: all)
# Available: repositories builds work testplans wiki search security
# DOMAINS=repositories builds work
